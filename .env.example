# URL de l'api-gateway FlexMo (sans slash final)
VITE_API_GATEWAY_URL=http://localhost:4000

# Environnement metier transmis dans l'en-tete `Env` (sandbox | production)
VITE_BACKOFFICE_ENV=sandbox

# Produit transmis dans l'en-tete `product` pour l'authentification admin
VITE_AUTH_PRODUCT=Flexmo-Fuel-Ops
